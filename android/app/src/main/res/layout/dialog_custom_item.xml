<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/pos_surface"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Custom Non-Catalog Item"
        android:textColor="@color/pos_text_primary"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add arbitrary counter item, accessory, or labor fee to cart:"
        android:textColor="@color/pos_text_secondary"
        android:textSize="11sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/et_custom_title"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:hint="Item Description (e.g. Screen Protector + Fitting)"
        android:textColorHint="@color/pos_text_muted"
        android:textColor="@color/pos_text_primary"
        android:background="@color/pos_surface_variant"
        android:paddingHorizontal="10dp"
        android:textSize="12sp"
        android:inputType="text"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <EditText
            android:id="@+id/et_custom_price"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:hint="Unit Price (KES)"
            android:textColorHint="@color/pos_text_muted"
            android:textColor="@color/pos_text_primary"
            android:background="@color/pos_surface_variant"
            android:paddingHorizontal="10dp"
            android:textSize="12sp"
            android:inputType="numberDecimal"
            android:layout_marginEnd="6dp" />

        <EditText
            android:id="@+id/et_custom_qty"
            android:layout_width="80dp"
            android:layout_height="42dp"
            android:hint="Qty"
            android:text="1"
            android:textColorHint="@color/pos_text_muted"
            android:textColor="@color/pos_text_primary"
            android:background="@color/pos_surface_variant"
            android:paddingHorizontal="10dp"
            android:textSize="12sp"
            android:inputType="number" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_custom_sku"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:hint="Optional SKU / Reference (e.g. CUSTOM-01)"
        android:textColorHint="@color/pos_text_muted"
        android:textColor="@color/pos_text_primary"
        android:background="@color/pos_surface_variant"
        android:paddingHorizontal="10dp"
        android:textSize="12sp"
        android:inputType="text" />
</LinearLayout>
