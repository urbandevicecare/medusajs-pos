<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/pos_surface"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Staff Authentication (Zero PIN)"
            android:textColor="@color/pos_text_primary"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter Medusa Admin credentials to start your till session:"
            android:textColor="@color/pos_text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MEDUSA ADMIN CREDENTIALS"
            android:textColor="@color/pos_accent"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_login_email"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="Email (admin@urbandevicecare.co.uk)"
            android:textColorHint="@color/pos_text_muted"
            android:textColor="@color/pos_text_primary"
            android:background="@color/pos_surface_variant"
            android:paddingHorizontal="10dp"
            android:textSize="12sp"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/et_login_password"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="Password"
            android:textColorHint="@color/pos_text_muted"
            android:textColor="@color/pos_text_primary"
            android:background="@color/pos_surface_variant"
            android:paddingHorizontal="10dp"
            android:textSize="12sp"
            android:inputType="textPassword" />
    </LinearLayout>
</ScrollView>
