<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pos_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_detail_ticket_number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="UDC-REP-001"
                android:textColor="@color/pos_text_primary"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_detail_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Received"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@color/pos_accent"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tv_detail_payment_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unpaid"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="@color/pos_danger"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_detail_created_at"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Created: 2026-11-20"
            android:textColor="@color/pos_text_muted"
            android:textSize="10sp"
            android:layout_marginBottom="10dp" />

        <!-- Client & Workshop Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/pos_surface_variant"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLIENT INFORMATION"
                android:textColor="@color/pos_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_detail_client_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apex Electronics (John Kamau)"
                android:textColor="@color/pos_text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_detail_client_contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tel: +254 700 112 233"
                android:textColor="@color/pos_text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="1dp" />

            <TextView
                android:id="@+id/tv_detail_tech_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Technician: Nelly K."
                android:textColor="@color/pos_accent"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Device & Fault Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/pos_surface_variant"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEVICE DETAILS"
                android:textColor="@color/pos_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_detail_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apple MacBook Pro 14&quot;"
                android:textColor="@color/pos_text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_detail_serial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/N: C02G1234MD6R"
                android:textColor="@color/pos_text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reported Fault:"
                android:textColor="@color/pos_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tv_detail_issue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Flickering screen lines"
                android:textColor="@color/pos_text_primary"
                android:textSize="11sp"
                android:background="@color/pos_surface"
                android:padding="6dp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Financials HUD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/pos_surface_variant"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_detail_estimate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimate: KES 25,000.00"
                    android:textColor="@color/pos_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_detail_deposit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deposit: KES 5,000.00"
                    android:textColor="@color/pos_success"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Balance Due"
                    android:textColor="@color/pos_text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_detail_balance_due"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KES 20,000.00"
                    android:textColor="@color/pos_accent"
                    android:textStyle="bold"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Inspection Footer Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_detail_push_stk"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Push M-Pesa STK"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#00A344"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_detail_close"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Close"
                    android:textSize="11sp"
                    android:backgroundTint="@color/pos_surface_variant"
                    android:textColor="@color/pos_text_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
