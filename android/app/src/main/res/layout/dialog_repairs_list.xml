<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/pos_surface"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Workshop Repairs"
            android:textColor="@color/pos_text_primary"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_repairs_dialog_book_new"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ Book Intake"
            android:textSize="10sp"
            android:backgroundTint="@color/pos_accent"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_repairs_search"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:hint="Search by ticket #, client, device, serial..."
        android:textColorHint="@color/pos_text_muted"
        android:textColor="@color/pos_text_primary"
        android:background="@color/pos_surface_variant"
        android:paddingHorizontal="10dp"
        android:textSize="11sp"
        android:layout_marginBottom="6dp" />

    <!-- Tabular Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/pos_surface_variant"
        android:paddingVertical="5dp"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="TICKET # / DATE"
            android:textColor="@color/pos_text_secondary"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:text="DEVICE / CLIENT"
            android:textColor="@color/pos_text_secondary"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="STATUS / DUE"
            android:textColor="@color/pos_text_secondary"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="55dp"
            android:layout_height="wrap_content"
            android:text="ACTION"
            android:textColor="@color/pos_text_secondary"
            android:textSize="9sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="280dp">

        <LinearLayout
            android:id="@+id/layout_repairs_items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
