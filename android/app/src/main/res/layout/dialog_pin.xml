<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/pos_surface"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cashier Handover PIN"
        android:textColor="@color/pos_text_primary"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter your 4-digit staff PIN to switch session:"
        android:textColor="@color/pos_text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/et_pin_code"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="••••"
        android:textColorHint="@color/pos_text_muted"
        android:textColor="@color/pos_text_primary"
        android:background="@color/pos_surface_variant"
        android:textSize="22sp"
        android:textAlignment="center"
        android:inputType="numberPassword"
        android:maxLength="4" />
</LinearLayout>
